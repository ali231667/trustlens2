# TrustLens gateway backend — copy this file to `.env` and fill in values.
# `.env` is gitignored; never commit real keys.

# RapidAPI key for the Instagram Scraper Stable API (get a free one at
# https://rapidapi.com/  -> "Instagram Scraper Stable API" -> Subscribe -> Basic).
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_KEY_COMMENTS=your_rapidapi_key_here

# Optional: Google Programmable Search, used by the credential verifier.
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=

# Module service registry — where each microservice is reachable.
# Change these if you run a module on a different host/port.
IMAGE_SERVICE_URL=http://127.0.0.1:8200
TRANSCRIBER_SERVICE_URL=http://127.0.0.1:8300
MISINFO_SERVICE_URL=http://127.0.0.1:8100
